<Project Sdk="IKVM.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Description>The Java language server of the IKVM Visual Studio extension: Eclipse JDT LS, running on Equinox in OSGi Connect mode, with every bundle an assembly compiled by IKVM.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IKVM.Maven.Sdk" Version="1.12.2" />
        <PackageReference Include="IKVM.JdkUtil.MSBuild" Version="1.0.4" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <JavaResource Include="src\main\resources\**\*" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!--
        JDT LS 0.57, the last release that runs on Java 8, and the bundles of its distribution that it requires, at the
        versions it ships with.
    -->
    <ItemGroup>
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.commands:3.9.700" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.contenttype:3.7.700" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.expressions:3.6.800" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.filebuffers:3.6.1000" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.filesystem:1.7.700" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.jobs:3.10.800" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.net:1.3.900" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.resources:3.13.700" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.runtime:3.18.0" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.core.variables:3.4.800" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.debug.core:3.15.100" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.equinox.app:1.4.500" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.equinox.common:3.12.0" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.equinox.preferences:3.8.0" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.equinox.registry:3.8.800" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.equinox.security:1.3.500" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.ltk.core.refactoring:3.11.0" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.osgi:3.16.300" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.osgi.services:3.8.0" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.osgi.util:3.5.300" />
        <MavenReference Include="org.eclipse.platform:org.eclipse.text:3.10.200" />
        <MavenReference Include="org.eclipse.jdt:org.eclipse.jdt.core:3.22.0" />
        <MavenReference Include="org.eclipse.jdt:org.eclipse.jdt.core.manipulation:1.14.0" />
        <MavenReference Include="org.eclipse.jdt:org.eclipse.jdt.debug:3.15.100" />
        <MavenReference Include="org.eclipse.jdt:org.eclipse.jdt.launching:3.17.100" />
        <MavenReference Include="org.eclipse.lsp4j:org.eclipse.lsp4j:0.9.0" />
        <MavenReference Include="org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc:0.9.0" />
        <MavenReference Include="org.eclipse.xtend:org.eclipse.xtend.lib:2.22.0" />
        <MavenReference Include="org.eclipse.xtend:org.eclipse.xtend.lib.macro:2.22.0" />
        <MavenReference Include="org.eclipse.xtext:org.eclipse.xtext.xbase.lib:2.22.0" />
        <!-- newer than JDT LS ships with: the host's Maven Indexer needs 2.8.6 or later, and the two share the version -->
        <MavenReference Include="com.google.code.gson:gson:2.8.9" />
        <MavenReference Include="com.google.guava:guava:27.1-jre" />
        <MavenReference Include="org.apache.commons:commons-lang3:3.1" />
        <MavenReference Include="log4j:log4j:1.2.17" />
        <MavenReference Include="org.eclipse.jdt.ls:org.eclipse.jdt.ls.core:0.57.0.20200619102332" />
        <!-- libraries JDT LS carries inside its bundle, on its Bundle-ClassPath -->
        <MavenReference Include="org.jsoup:jsoup:1.9.2" />
        <MavenReference Include="com.kotcrab.remark:remark:1.2.0" />
    </ItemGroup>

    <Import Project="IKVM.VisualStudio.JavaLanguageServer.Maven.targets" />
    <Import Project="IKVM.VisualStudio.JavaLanguageServer.Jdk.targets" />

</Project>
