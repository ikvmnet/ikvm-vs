<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
                    xmlns:local="clr-namespace:IKVM.VisualStudio.ProjectSystem.UI">

    <!-- a value that differs between the target frameworks being edited, and one that is not valid -->
    <SolidColorBrush x:Key="VariesBrush" Color="#E0A526" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5534B" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:FalseToVisibleConverter x:Key="NotVisible" />

    <!-- the heading of a section of the details: an icon and a name, under a line -->
    <Style x:Key="SectionRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4,0,14" />
        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
    </Style>
    <Style x:Key="SectionHeaderPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SectionIcon" TargetType="imaging:CrispImage">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment111PercentFontSizeKey}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- a flat icon button on a list row -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelTextBrushKey}}" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonHoverBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a field's single border: focused, varies between target frameworks, or not valid -->
    <Style TargetType="local:Field">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Field">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderFocusedBrushKey}}" />
            </Trigger>
            <Trigger Property="State" Value="Varies">
                <Setter Property="BorderBrush" Value="{StaticResource VariesBrush}" />
            </Trigger>
            <Trigger Property="State" Value="Error">
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- the hint shown in an empty text field -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- where an item dragged into an ordered list would land -->
    <Style x:Key="DropLine" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.FocusVisualBrushKey}}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- the target frameworks an entry is limited to -->
    <Style x:Key="BadgeList" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border CornerRadius="7" Padding="5,0" Margin="4,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}">
                        <TextBlock Text="{Binding}" FontSize="10" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
