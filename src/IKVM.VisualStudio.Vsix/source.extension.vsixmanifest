<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
	<Metadata>
		<Identity Id="IKVM.VisualStudio.8bf8ccd4-363a-4a23-a857-b038314c2c9e" Version="|%CurrentProject%;GetVsixVersion|" Language="en-US" Publisher="IKVM" />
		<DisplayName>IKVM Extension for Visual Studio</DisplayName>
		<Description>Brings Java project support to Visual Studio. Create, build, and manage .ikvmproj projects that compile Java source code to .NET assemblies using the IKVM.NET SDK. Java source files get Visual Studio's built-in Java syntax highlighting.</Description>
		<MoreInfo>https://github.com/ikvmnet/ikvm-vs</MoreInfo>
		<License>LICENSE</License>
		<Icon>Images\ikvm.png</Icon>
		<Tags>ikvm;java;jvm;dotnet;interop;cross-platform</Tags>
	</Metadata>
	<Installation ExtensionType="VSSDK+VisualStudio.Extensibility" InstalledByMsi="false" AllUsers="false">
		<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
		<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,)">
			<ProductArchitecture>arm64</ProductArchitecture>
		</InstallationTarget>
	</Installation>
	<Dependencies>
		<Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
	</Dependencies>
	<Prerequisites>
		<Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,)" DisplayName="Visual Studio core editor" />
	</Prerequisites>
	<Assets>
		<Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
		<Asset Type="Microsoft.VisualStudio.Assembly" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" AssemblyName="|%CurrentProject%;AssemblyName|" />
		<Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
		<Asset Type="Microsoft.VisualStudio.ImageManifest" d:Source="File" Path="IKVM.VisualStudio.imagemanifest" />
		<Asset Type="Microsoft.VisualStudio.Assembly" d:Source="Project" d:ProjectName="IKVM.VisualStudio.ProjectSystem.Abstractions" Path="|IKVM.VisualStudio.ProjectSystem.Abstractions|" AssemblyName="|IKVM.VisualStudio.ProjectSystem.Abstractions;AssemblyName|" />
		<Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="IKVM.VisualStudio.Maven" Path="|IKVM.VisualStudio.Maven|" />
		<Asset Type="Microsoft.VisualStudio.ImageManifest" d:Source="File" Path="IKVM.VisualStudio.Maven.imagemanifest" />
		<Asset Type="Microsoft.ServiceHub.Service" d:Source="File" Path="Host\IKVM.VisualStudio.Host.Maven.servicehub.service.json" />
		<Asset Type="Microsoft.ServiceHub.Service" d:Source="File" Path="Host\IKVM.VisualStudio.Host.JavaLanguageServer.servicehub.service.json" />
		<Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="Host\IKVM.VisualStudio.Host.pkgdef" />
	</Assets>
</PackageManifest>
