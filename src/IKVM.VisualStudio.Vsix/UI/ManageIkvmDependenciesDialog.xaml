<vsui:DialogWindow x:Class="IKVM.VisualStudio.Vsix.UI.ManageIkvmDependenciesDialog"
                   x:ClassModifier="internal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                   xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                   xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
                   xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
                   xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
                   xmlns:ui="clr-namespace:IKVM.VisualStudio.ProjectSystem.UI;assembly=IKVM.VisualStudio.ProjectSystem.Abstractions"
                   vsui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
                   Foreground="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelTextBrushKey}}"
                   FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
                   FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
                   Title="Manage IKVM Dependencies"
                   Width="1000" Height="780" MinWidth="760" MinHeight="520"
                   WindowStartupLocation="CenterOwner"
                   ShowInTaskbar="False"
                   ResizeMode="CanResizeWithGrip"
                   AllowDrop="True"
                   Drop="OnDrop"
                   DragOver="OnDragOver">

    <vsui:DialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IKVM.VisualStudio.ProjectSystem.Abstractions;component/UI/IkvmDependencyStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- a target framework chip: outlined in the accent color while being edited -->
            <Style x:Key="FrameworkChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonPressedBrushKey}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- a flat segment of a chip -->
            <Style x:Key="ChipPart" TargetType="Button">
                <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Collapsible" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </vsui:DialogWindow.Resources>

    <Grid Background="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelBrushKey}}"
          theming:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelColorKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- all references, as they will be after saving -->
            <DockPanel Grid.Column="0" Margin="16,16,10,0">
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AddCommands}" Focusable="False" Margin="0,0,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:IkvmDependencyAddCommand}">
                            <Button Click="OnAdd" MinWidth="72" Margin="0,0,6,6" AutomationProperties.Name="{Binding Description}" ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <imaging:CrispImage Moniker="{Binding Icon}" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Text="Drop files or folders here to add them." />
                <ListBox x:Name="EntryList" KeyDown="OnEntryListKeyDown" PreviewMouseLeftButtonDown="OnEntryListMouseDown" PreviewMouseMove="OnEntryListMouseMove" PreviewMouseLeftButtonUp="OnEntryListMouseUp" ContextMenuOpening="OnEntryContextMenuOpening" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" AutomationProperties.Name="IKVM dependencies">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SectionHeader}" Margin="2,8,0,4">
                                        <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:IkvmDependencyEntry}">
                            <Border x:Name="RowFrame" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="3,0,0,0">
                            <DockPanel x:Name="Row" Margin="2" Background="Transparent" ToolTip="{Binding ImportedToolTip}">
                                <imaging:CrispImage x:Name="ErrorIcon" DockPanel.Dock="Right" Moniker="{x:Static catalog:KnownMonikers.StatusError}" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ErrorToolTip}" Visibility="Collapsed" />
                                <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="&#xE711;" Click="OnRemoveItem" ToolTip="Remove" AutomationProperties.Name="Remove" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Hidden" />
                                <imaging:CrispImage DockPanel.Dock="Left" Moniker="{Binding Icon}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="Name" Grid.ColumnSpan="2" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl Grid.Row="1" Grid.Column="1" Style="{StaticResource BadgeList}" ItemsSource="{Binding Badges}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                                </Grid>
                            </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                    <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RemoveButton" Property="Content" Value="&#xE7A7;" />
                                    <Setter TargetName="RemoveButton" Property="ToolTip" Value="Undo remove" />
                                    <Setter TargetName="RemoveButton" Property="AutomationProperties.Name" Value="Undo remove" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsImported}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- details of the selected reference -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,16,16,0" Padding="0,0,4,0">
                <StackPanel x:Name="Details" DataContext="{Binding SelectedEntry}">
                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource {x:Static vsshell:VsFonts.Environment133PercentFontSizeKey}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Location}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,0,0,12" Style="{StaticResource Collapsible}">
                        <imaging:CrispImage DockPanel.Dock="Left" Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Errors}" Focusable="False" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <imaging:CrispImage DockPanel.Dock="Left" Moniker="{x:Static catalog:KnownMonikers.StatusError}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- where the reference is used, and which target frameworks' settings are shown and edited -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding DataContext.HasTargetFrameworks, ElementName=EntryList, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SectionRule}" />
                        <StackPanel Style="{StaticResource SectionHeaderPanel}">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Library}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Target frameworks" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:TargetFrameworkChip}">
                                    <Border x:Name="Chip" Style="{StaticResource FrameworkChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ChipPart}" Padding="5,0" Click="OnChipUsedClick" IsEnabled="{Binding CanChangeUsed}" ToolTip="{Binding UsedToolTip}" AutomationProperties.Name="{Binding UsedToolTip}">
                                                <Border x:Name="Box" Width="14" Height="14" CornerRadius="2" BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Background="Transparent">
                                                    <Path x:Name="Check" Data="M2,6 L5,9 L10.5,2.5" StrokeThickness="1.6" Stroke="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDefaultTextBrushKey}}" Visibility="Collapsed" />
                                                </Border>
                                            </Button>
                                            <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" Margin="3,0,3,0" />
                                            <Button Style="{StaticResource ChipPart}" Padding="5,0" Click="OnChipEditingClick" ToolTip="{Binding EditingToolTip}" AutomationProperties.Name="{Binding EditingToolTip}">
                                                <Canvas x:Name="Eye" Width="16" Height="12">
                                                    <Path Data="M1,6 C3,2.2 5.4,1 8,1 C10.6,1 13,2.2 15,6 C13,9.8 10.6,11 8,11 C5.4,11 3,9.8 1,6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                                    <Ellipse Canvas.Left="6" Canvas.Top="4" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                                    <Path x:Name="Slash" Data="M2,11.5 L14,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                                </Canvas>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDefaultBrushKey}}" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUsed}" Value="False">
                                            <Setter TargetName="Label" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Slash" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                            <Setter TargetName="Eye" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Margin="0,0,0,12" Opacity="0.85" Text="{Binding NothingEditingText}" Visibility="{Binding HasEditing, Converter={StaticResource NotVisible}}" />

                    <!-- the settings of the entry, from its provider -->
                    <ContentPresenter Content="{Binding View}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- footer -->
        <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Save" IsDefault="True" Click="OnSave" IsEnabled="{Binding CanSave}" MinWidth="96" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" />
            </StackPanel>
            <CheckBox Content="Use paths _relative to the project for new references" IsChecked="{Binding UseRelativePaths}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</vsui:DialogWindow>
