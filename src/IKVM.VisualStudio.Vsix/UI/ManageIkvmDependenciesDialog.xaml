<vsui:DialogWindow x:Class="IKVM.VisualStudio.Vsix.UI.ManageIkvmDependenciesDialog"
                   x:ClassModifier="internal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                   xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                   xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
                   xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
                   xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
                   xmlns:ikvm="clr-namespace:IKVM.VisualStudio.Vsix.Imaging"
                   xmlns:local="clr-namespace:IKVM.VisualStudio.Vsix.UI"
                   vsui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
                   Foreground="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelTextBrushKey}}"
                   FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
                   FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
                   Title="Manage IKVM Dependencies"
                   Width="1000" Height="780" MinWidth="760" MinHeight="520"
                   WindowStartupLocation="CenterOwner"
                   ShowInTaskbar="False"
                   ResizeMode="CanResizeWithGrip"
                   AllowDrop="True"
                   Drop="OnDrop"
                   DragOver="OnDragOver">

    <vsui:DialogWindow.Resources>
        <!-- a value that differs between the target frameworks being edited, and one that is not valid -->
        <SolidColorBrush x:Key="VariesBrush" Color="#E0A526" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#E5534B" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:FalseToVisibleConverter x:Key="NotVisible" />
        <!-- a target framework chip: outlined in the accent color while being edited -->
        <Style x:Key="FrameworkChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}" />
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonPressedBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- a flat segment of a chip -->
        <Style x:Key="ChipPart" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:ReferenceKindMonikerConverter x:Key="ReferenceKindMoniker" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource {x:Static vsshell:VsFonts.Environment111PercentFontSizeKey}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- a flat icon button on a list row -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelTextBrushKey}}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonHoverBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- a field's single border: focused, varies between target frameworks, or not valid -->
        <Style TargetType="local:Field">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:Field">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderFocusedBrushKey}}" />
                </Trigger>
                <Trigger Property="State" Value="Varies">
                    <Setter Property="BorderBrush" Value="{StaticResource VariesBrush}" />
                </Trigger>
                <Trigger Property="State" Value="Error">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- where an item dragged into an ordered list would land -->
        <Style x:Key="DropLine" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.FocusVisualBrushKey}}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- the target frameworks a reference is limited to -->
        <Style x:Key="BadgeList" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border CornerRadius="7" Padding="5,0" Margin="4,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}">
                            <TextBlock Text="{Binding}" FontSize="10" />
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- a reference in the Depends on Add menu -->
        <DataTemplate x:Key="DependencyMenuHeader" DataType="{x:Type local:DependencyOption}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                <ItemsControl Style="{StaticResource BadgeList}" ItemsSource="{Binding Target.Badges}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
        </DataTemplate>
        <!-- the line above each section of the details -->
        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,4,0,14" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="imaging:CrispImage">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="Collapsible" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </vsui:DialogWindow.Resources>

    <Grid Background="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelBrushKey}}"
          theming:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static vsui:ThemedDialogColors.WindowPanelColorKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- all references, as they will be after saving -->
            <DockPanel Grid.Column="0" Margin="16,16,10,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Click="OnAddJars" MinWidth="72" Margin="0,0,6,0" AutomationProperties.Name="Add JAR files">
                        <StackPanel Orientation="Horizontal">
                            <imaging:CrispImage Moniker="{x:Static ikvm:IkvmMonikers.JarFile}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="JARs..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnAddFolder" MinWidth="72" Margin="0,0,6,0" AutomationProperties.Name="Add class folder">
                        <StackPanel Orientation="Horizontal">
                            <imaging:CrispImage Moniker="{x:Static ikvm:IkvmMonikers.ClassFolder}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Folder..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Text="Drop .jar files or class folders here." />
                <ListBox x:Name="EntryList" KeyDown="OnEntryListKeyDown" PreviewMouseLeftButtonDown="OnEntryListMouseDown" PreviewMouseMove="OnEntryListMouseMove" PreviewMouseLeftButtonUp="OnEntryListMouseUp" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" AutomationProperties.Name="IKVM dependencies">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SectionHeader}" Margin="2,8,0,4">
                                        <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:IkvmDependencyEntry}">
                            <Border x:Name="RowFrame" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="3,0,0,0">
                            <DockPanel x:Name="Row" Margin="2" Background="Transparent" ToolTip="{Binding ImportedToolTip}">
                                <imaging:CrispImage x:Name="ErrorIcon" DockPanel.Dock="Right" Moniker="{x:Static catalog:KnownMonikers.StatusError}" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ErrorToolTip}" Visibility="Collapsed" />
                                <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="&#xE711;" Click="OnRemoveItem" ToolTip="Remove" AutomationProperties.Name="Remove" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Hidden" />
                                <imaging:CrispImage DockPanel.Dock="Left" Moniker="{Binding IsDirectory, Converter={StaticResource ReferenceKindMoniker}}" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="Name" Grid.ColumnSpan="2" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{Binding DirectoryName}" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl Grid.Row="1" Grid.Column="1" Style="{StaticResource BadgeList}" ItemsSource="{Binding Badges}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                                </Grid>
                            </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                    <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RemoveButton" Property="Content" Value="&#xE7A7;" />
                                    <Setter TargetName="RemoveButton" Property="ToolTip" Value="Undo remove" />
                                    <Setter TargetName="RemoveButton" Property="AutomationProperties.Name" Value="Undo remove" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsImported}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- details of the selected reference -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,16,16,0" Padding="0,0,4,0">
                <StackPanel x:Name="Details" DataContext="{Binding SelectedEntry}">
                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource {x:Static vsshell:VsFonts.Environment133PercentFontSizeKey}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FullPath}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,0,0,12" Style="{StaticResource Collapsible}">
                        <imaging:CrispImage DockPanel.Dock="Left" Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Errors}" Focusable="False" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <imaging:CrispImage DockPanel.Dock="Left" Moniker="{x:Static catalog:KnownMonikers.StatusError}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- where the reference is used, and which target frameworks' settings are shown and edited -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding DataContext.HasTargetFrameworks, ElementName=EntryList, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SectionRule}" />
                        <StackPanel Style="{StaticResource SectionHeaderPanel}">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Library}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Target frameworks" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TargetFrameworkChip}">
                                    <Border x:Name="Chip" Style="{StaticResource FrameworkChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ChipPart}" Padding="5,0" Click="OnChipUsedClick" IsEnabled="{Binding CanChangeUsed}" ToolTip="{Binding UsedToolTip}" AutomationProperties.Name="{Binding UsedToolTip}">
                                                <Border x:Name="Box" Width="14" Height="14" CornerRadius="2" BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Background="Transparent">
                                                    <Path x:Name="Check" Data="M2,6 L5,9 L10.5,2.5" StrokeThickness="1.6" Stroke="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDefaultTextBrushKey}}" Visibility="Collapsed" />
                                                </Border>
                                            </Button>
                                            <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" Margin="3,0,3,0" />
                                            <Button Style="{StaticResource ChipPart}" Padding="5,0" Click="OnChipEditingClick" ToolTip="{Binding EditingToolTip}" AutomationProperties.Name="{Binding EditingToolTip}">
                                                <Canvas x:Name="Eye" Width="16" Height="12">
                                                    <Path Data="M1,6 C3,2.2 5.4,1 8,1 C10.6,1 13,2.2 15,6 C13,9.8 10.6,11 8,11 C5.4,11 3,9.8 1,6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                                    <Ellipse Canvas.Left="6" Canvas.Top="4" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                                    <Path x:Name="Slash" Data="M2,11.5 L14,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                                </Canvas>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDefaultBrushKey}}" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUsed}" Value="False">
                                            <Setter TargetName="Label" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Slash" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                            <Setter TargetName="Eye" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Margin="0,0,0,12" Opacity="0.85" Text="{Binding NothingEditingText}" Visibility="{Binding HasEditing, Converter={StaticResource NotVisible}}" />

                    <StackPanel IsEnabled="{Binding CanEdit}">

                        <Border Style="{StaticResource SectionRule}" />
                        <StackPanel Style="{StaticResource SectionHeaderPanel}">
                            <imaging:CrispImage Moniker="{x:Static ikvm:IkvmMonikers.ClassFile}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Compile" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Add..." Click="OnAddClasses" MinWidth="64" VerticalAlignment="Top" Margin="6,0,0,0" />
                            <StackPanel>
                                <local:Field State="{Binding CompileFrame}" ToolTip="{Binding ClassesVariations}">
                                    <ListBox x:Name="ClassList" BorderThickness="0" ItemsSource="{Binding ClassItems}" MinHeight="44" MaxHeight="120" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Compile">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PathItem}">
                                                <Grid>
                                                    <DockPanel x:Name="Row" Background="Transparent" ToolTip="{Binding ToolTip}">
                                                        <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="&#xE711;" Click="OnRemoveClass" ToolTip="Remove" AutomationProperties.Name="Remove" Visibility="Hidden" />
                                                        <imaging:CrispImage DockPanel.Dock="Left" Moniker="{Binding IsDirectory, Converter={StaticResource ReferenceKindMoniker}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="Text" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <Border x:Name="DropBefore" Style="{StaticResource DropLine}" VerticalAlignment="Top" Margin="0,-3,0,0" />
                                                    <Border x:Name="DropAfter" Style="{StaticResource DropLine}" VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropBefore}" Value="True">
                                                        <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropAfter}" Value="True">
                                                        <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </local:Field>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SectionRule}" />
                        <StackPanel Style="{StaticResource SectionHeaderPanel}">
                            <imaging:CrispImage Moniker="{x:Static ikvm:IkvmMonikers.JavaSource}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Sources" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Add..." Click="OnAddSources" MinWidth="64" VerticalAlignment="Top" Margin="6,0,0,0" />
                            <StackPanel>
                                <local:Field State="{Binding SourcesFrame}" ToolTip="{Binding SourcesVariations}">
                                    <ListBox x:Name="SourceList" BorderThickness="0" ItemsSource="{Binding SourceItems}" MinHeight="44" MaxHeight="120" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sources">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PathItem}">
                                                <Grid>
                                                    <DockPanel x:Name="Row" Background="Transparent" ToolTip="{Binding ToolTip}">
                                                        <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="&#xE711;" Click="OnRemoveSource" ToolTip="Remove" AutomationProperties.Name="Remove" Visibility="Hidden" />
                                                        <imaging:CrispImage DockPanel.Dock="Left" Moniker="{x:Static ikvm:IkvmMonikers.JavaSource}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="Text" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <Border x:Name="DropBefore" Style="{StaticResource DropLine}" VerticalAlignment="Top" Margin="0,-3,0,0" />
                                                    <Border x:Name="DropAfter" Style="{StaticResource DropLine}" VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropBefore}" Value="True">
                                                        <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropAfter}" Value="True">
                                                        <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </local:Field>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource SectionRule}" />
                        <StackPanel Style="{StaticResource SectionHeaderPanel}">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Assembly}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Generated assembly" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="_Assembly name" Target="{Binding ElementName=AssemblyNameBox}" Padding="0,0,0,4" />
                                <local:Field State="{Binding AssemblyNameFrame}" ToolTip="{Binding AssemblyNameVariations}">
                                <Grid>
                                    <TextBox x:Name="AssemblyNameBox" BorderThickness="0" Text="{Binding AssemblyName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Placeholder}" Text="{Binding AssemblyNamePlaceholder}" Visibility="{Binding Text.IsEmpty, ElementName=AssemblyNameBox, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                </local:Field>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Assembly _version" Target="{Binding ElementName=AssemblyVersionBox}" Padding="0,0,0,4" />
                                <local:Field State="{Binding AssemblyVersionFrame}" ToolTip="{Binding AssemblyVersionVariations}">
                                <Grid>
                                    <TextBox x:Name="AssemblyVersionBox" BorderThickness="0" Text="{Binding AssemblyVersion, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Placeholder}" Text="{Binding AssemblyVersionPlaceholder}" Visibility="{Binding Text.IsEmpty, ElementName=AssemblyVersionBox, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                </local:Field>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SectionRule}" />
                        <StackPanel Style="{StaticResource SectionHeaderPanel}">
                            <imaging:CrispImage Moniker="{x:Static ikvm:IkvmMonikers.IkvmDependencies}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Depends on" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Add..." Click="OnAddDependency" MinWidth="64" VerticalAlignment="Top" Margin="6,0,0,0" />
                            <local:Field State="{Binding DependenciesFrame}">
                                <ListBox x:Name="DependencyList" BorderThickness="0" ItemsSource="{Binding ReferencedDependencies}" MinHeight="44" MaxHeight="120" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Depends on">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:DependencyOption}">
                                            <Grid>
                                            <Border x:Name="RowFrame" BorderThickness="3,0,0,0" BorderBrush="Transparent" HorizontalAlignment="Left" Width="3" />
                                            <DockPanel x:Name="Row" Background="Transparent" Margin="6,0,0,0" ToolTip="{Binding ToolTip}">
                                                <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="&#xE711;" Click="OnRemoveDependency" ToolTip="Remove" AutomationProperties.Name="Remove" Visibility="Hidden" />
                                                <imaging:CrispImage DockPanel.Dock="Left" Moniker="{Binding Target.IsDirectory, Converter={StaticResource ReferenceKindMoniker}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <ItemsControl DockPanel.Dock="Right" Style="{StaticResource BadgeList}" ItemsSource="{Binding Target.Badges}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                                <TextBlock x:Name="DependencyName" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <Border x:Name="DropBefore" Style="{StaticResource DropLine}" VerticalAlignment="Top" Margin="0,-3,0,0" />
                                            <Border x:Name="DropAfter" Style="{StaticResource DropLine}" VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="{x:Null}">
                                                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                    <Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                    <Setter TargetName="DependencyName" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropBefore}" Value="True">
                                                    <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropAfter}" Value="True">
                                                    <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </local:Field>
                        </DockPanel>

                        <TextBlock TextWrapping="Wrap" Text="More settings are available in the Properties window." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- footer -->
        <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Save" IsDefault="True" Click="OnSave" IsEnabled="{Binding CanSave}" MinWidth="96" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" />
            </StackPanel>
            <CheckBox Content="Use paths _relative to the project for new references" IsChecked="{Binding UseRelativePaths}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</vsui:DialogWindow>
